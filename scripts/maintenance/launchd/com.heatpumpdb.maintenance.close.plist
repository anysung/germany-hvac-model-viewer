<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Monthly maintenance window — the 04:00 Europe/Berlin guard.

  Runs whether or not the window succeeded. If the run completed it finds the
  notice already lifted and does nothing; if the run stopped for a person and no
  instruction arrived, it restores service on the version that was already live.
  An unattended window must not be able to leave five sites dark.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.heatpumpdb.maintenance.close</string>
  <key>ProgramArguments</key>
  <array><string>/Users/christophersung/heatpumpdb-app/scripts/maintenance/close-window.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/christophersung/heatpumpdb-app/.maintenance/launchd-close.log</string>
  <key>StandardErrorPath</key><string>/Users/christophersung/heatpumpdb-app/.maintenance/launchd-close.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
